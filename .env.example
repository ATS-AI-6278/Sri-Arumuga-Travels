# Public site origin (canonical / Open Graph / JSON-LD). No secrets.
VITE_SITE_URL=https://sriarumugatravels.vercel.app

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX). Leave empty until you create a GA4 property.
VITE_GA4_MEASUREMENT_ID=

# Microsoft Clarity project ID. Leave empty until you create a Clarity project.
VITE_CLARITY_PROJECT_ID=yrhkngc4c4

# Google Search Console HTML tag verification token (content value only). Leave empty until you verify the property.
VITE_GSC_VERIFICATION=

# --- Enquiry email (Web3Forms) ---
# Free path: create an access key at https://web3forms.com
# Point the PRIMARY key to owner inbox: arumugatamilselvan@gmail.com
# Optional PUBLIC key to business inbox: sriviarumugatravels@gmail.com
# (Free Web3Forms = one inbox per key. Two free keys → both Gmails get submissions.)
# Access keys are public by design (client-safe). Do NOT invent keys — leave empty until created.
VITE_WEB3FORMS_ACCESS_KEY=
VITE_WEB3FORMS_ACCESS_KEY_PUBLIC=

# Legacy / alternate: generic Formspree or Web3Forms endpoint.
# Web3Forms: VITE_FORM_ENDPOINT=https://api.web3forms.com/submit and VITE_FORM_ACCESS_KEY=<key>
# Formspree: VITE_FORM_ENDPOINT=https://formspree.io/f/<your-form-id> (no access key)
# Prefer VITE_WEB3FORMS_* above when using Web3Forms.
VITE_FORM_ENDPOINT=
VITE_FORM_ACCESS_KEY=
